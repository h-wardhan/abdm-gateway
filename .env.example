# ---------------------------------------------------------------------------
# abdm-gateway environment. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# development | production | testing
FLASK_ENV=development
# For the `flask` CLI (db migrations, clients management)
FLASK_APP=run.py
PORT=5000

# Secrets. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
# AES-256-GCM key for anything stored encrypted at rest. Generate with:
#   python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# Database. Empty = local SQLite file (instance/abdm_gateway.db), fine for dev only.
# DATABASE_URL=postgresql://abdm:abdm@localhost:5432/abdm_gateway
DATABASE_URL=

# Redis for token cache + rate limits. Empty = in-process memory (single process only).
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Tokens we issue to client apps (seconds)
CLIENT_TOKEN_EXPIRES=1800
CLIENT_REFRESH_TOKEN_EXPIRES=86400
# Per-IP limit on POST /api/v1/auth/session (i-medicus opens a session before every call)
SESSION_RATE_LIMIT=600 per minute
# Audit rows older than this are removed by `flask audit purge`
AUDIT_LOG_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# ABDM — our own NHA credentials (issued by NHA at sandbox.abdm.gov.in).
# NOT the credentials client apps use to call this gateway; those are issued with
# `flask clients create` and stored hashed in the api_clients table.
# ---------------------------------------------------------------------------
# sbx = sandbox, prod = production. Picks default URLs and X-CM-ID below.
ABDM_ENV=sbx
NHA_CLIENT_ID=
NHA_CLIENT_SECRET=
# Optional overrides; leave empty to use the ABDM_ENV defaults
#   sbx : https://dev.abdm.gov.in   | https://abhasbx.abdm.gov.in | sbx
#   prod: https://live.abdm.gov.in  | https://abha.abdm.gov.in    | abdm
ABDM_GATEWAY_URL=
ABDM_ABHA_URL=
ABDM_X_CM_ID=
ABDM_TIMEOUT_CONNECT=5
ABDM_TIMEOUT_READ=30
# Optional: ABDM public key for RSA encryption (base64 DER or PEM). Empty = fetched from
# /abha/api/v3/profile/public/certificate and cached for ABDM_PUBLIC_KEY_CACHE_SECONDS.
ABDM_PUBLIC_KEY=
ABDM_PUBLIC_KEY_CACHE_SECONDS=21600
# How long a txnId stays bound to the client app that started the flow
ABDM_TXN_TTL_SECONDS=1800
# Duplicate-request guard: max seconds a POST is held "in progress", and how long a response sent
# with an Idempotency-Key header is kept for replay
IDEMPOTENCY_LOCK_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# ABDM callbacks (ABDM -> gateway -> client app) and the retry worker
# ---------------------------------------------------------------------------
# Public https URL of this gateway: the bridge URL registered with ABDM (flask abdm bridge-url set)
GATEWAY_PUBLIC_URL=
# jwt = reject callbacks without a valid ABDM JWT (default; the only value allowed with ABDM_ENV=prod)
# observe = verify and log, never reject (look at real sandbox callbacks first)
# off = no verification (local mock ABDM only)
CALLBACK_AUTH_MODE=jwt
# Where ABDM's public keys are published. Empty = {ABDM_GATEWAY_URL}/api/hiecm/gateway/v3/certs
ABDM_JWKS_URL=
ABDM_JWKS_CACHE_SECONDS=21600
# Callback bodies can be large (health records): bigger limit than the rest of the API
CALLBACK_MAX_BYTES=10485760
# Callback URLs registered by client apps must be https and public. Loosen only for staging / local tests:
CALLBACK_ALLOW_HTTP=false
CALLBACK_ALLOW_PRIVATE_URLS=false
# Hosts that can never be a callback target (production webhooks), comma separated
CALLBACK_BLOCKED_HOSTS=app.i-medicus.in
# Stored callbacks (health data, encrypted) are purged by `flask audit purge` after this many days
CALLBACK_RETENTION_DAYS=30
# Retry worker (`flask worker run`): poll interval, batch size, tries, wait before each retry (seconds)
OUTBOX_POLL_SECONDS=1
OUTBOX_BATCH=20
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_BACKOFF_SECONDS=2,10,60,300,900,3600
OUTBOX_LOCK_SECONDS=60
OUTBOX_HTTP_TIMEOUT=15

# ---------------------------------------------------------------------------
# Logging / docs
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_LEVEL_LIBS=WARNING
LOG_DIR=logs
# Swagger UI at /docs
SWAGGER_ENABLED=true
# Default per-client rate limit
DEFAULT_RATE_LIMIT=120 per minute
