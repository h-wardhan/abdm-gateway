# Copy to `.env` ON THE SERVER, next to docker-compose.server.yml, and fill it in. This file is never
# committed with real values and CI/CD never overwrites the server's .env.
#
# The application settings are the same as the project's .env.example (SECRET_KEY, JWT_SECRET_KEY,
# ENCRYPTION_KEY, NHA_CLIENT_ID / NHA_CLIENT_SECRET, ...). What is specific to the server:

# Compose (not read by the app)
GATEWAY_IMAGE=ghcr.io/h-wardhan/abdm-gateway
APP_PORT=5000

# Sandbox. Do not switch to prod without the production checklist (see deploy/README.md).
ABDM_ENV=sbx
FLASK_ENV=production

# MUST be the database the gateway already uses (it holds the client credentials i-medicus signs in with).
# SQLite works for a single server: sqlite:////app/instance/abdm_gateway.db (kept in the gateway-instance volume)
DATABASE_URL=
REDIS_URL=

# Same key on app and worker, and never lose it: stored callbacks are encrypted with it.
ENCRYPTION_KEY=

# Callbacks
GATEWAY_PUBLIC_URL=https://abdm-gateway.example.com
CALLBACK_AUTH_MODE=jwt
CALLBACK_BLOCKED_HOSTS=app.i-medicus.in
# Staging i-medicus runs on plain http: allow it here only while the callback target is that server
CALLBACK_ALLOW_HTTP=true

# Only when using the bundled database (--profile bundled)
POSTGRES_PASSWORD=
