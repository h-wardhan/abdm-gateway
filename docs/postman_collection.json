{
  "info": {
    "name": "ABDM Gateway (M1)",
    "description": "abdm-gateway M1 API. Set baseUrl, clientId, clientSecret, run 'Create session' first. Sandbox OTPs arrive on the Aadhaar/ABHA-linked mobile (with scripts/mock_abdm.py the OTP is 123456).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://abdm-gateway.example.com"
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "clientSecret",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "txnId",
      "value": ""
    },
    {
      "key": "xToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Session",
      "description": "",
      "item": [
        {
          "name": "Create session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "session"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"clientSecret\": \"{{clientSecret}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('accessToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{accessToken}}"
              },
              {
                "key": "Client-Id",
                "value": "{{clientId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "1. ABHA creation (Aadhaar OTP)",
      "description": "",
      "item": [
        {
          "name": "Send Aadhaar OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{accessToken}}"
              },
              {
                "key": "Client-Id",
                "value": "{{clientId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/abha/enrol/aadhaar/otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "abha",
                "enrol",
                "aadhaar",
                "otp"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aadhaarNumber\": \"999941057058\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data || {}; if (d.txnId) pm.collectionVariables.set('txnId', d.txnId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Aadhaar OTP (create ABHA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
