              },
              {
                "key": "Client-Id",
                "value": "{{clientId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/abha/enrol/aadhaar/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "abha",
                "enrol",
                "aadhaar",
                "verify"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"txnId\": \"{{txnId}}\",\n  \"otpValue\": \"123456\",\n  \"mobilenumber\": \"9876543210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data || {}; const t = d.token || (d.tokens && d.tokens.token); if (t) pm.collectionVariables.set('xToken', t); if (d.txnId) pm.collectionVariables.set('txnId', d.txnId);"
                ]
              }
            }
          ]
        },
